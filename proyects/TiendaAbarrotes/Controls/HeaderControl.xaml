<UserControl x:Class="TiendaAbarrotes.Controls.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="70">
    <Border Background="White" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1">
        <Grid Margin="25,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Menu" Width="20" Height="20" 
                                          Foreground="{StaticResource BrushTextoSecundario}"/>
                <TextBlock Text="AbarrotesPOS" Margin="15,0,0,0" Foreground="{StaticResource BrushAcento}" 
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" / " Foreground="{StaticResource BrushTextoTerciario}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PaginaActual}" Foreground="{StaticResource BrushTextoPrincipal}" 
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Usuario -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding UsuarioActual.Nombre, StringFormat='Bienvenido, {0}'}" 
                           Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Ellipse Width="36" Height="36" Fill="{StaticResource BrushAcento}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>