<UserControl x:Class="TiendaAbarrotes.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="240">
    <Grid Background="{StaticResource BrushSidebarGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Logo -->
            <RowDefinition Height="*"/>     <!-- 1: Menú -->
            <RowDefinition Height="Auto"/>  <!-- 2: Footer (Respaldo + Usuario) -->
        </Grid.RowDefinitions>

        <!-- 0. LOGO -->
        <StackPanel Grid.Row="0" Margin="20,25,20,25">
            <TextBlock Text="AbarrotesPOS" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="BUSINESS PLATFORM" FontSize="10" Foreground="#8899AA" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 1. MENÚ DE NAVEGACIÓN -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding SidebarItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.NavigateCommand, 
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="12,2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                     Width="20" Height="20" 
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Titulo}" Margin="12,0,0,0" 
                                       VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. FOOTER: Botón de Respaldo y Perfil de Usuario -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            
           
            <!-- Usamos RelativeSource AncestorType=UserControl para encontrar el comando en el MainViewModel -->
                        
                        <!-- Botón de Respaldo Manual (Solo ADMIN) -->
            <Button Command="{Binding DataContext.CrearRespaldoManualCommand, 
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="12,5,12,5">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsuarioActual.Rol}" Value="ADMIN">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloudUploadOutline" Width="20" Height="20" 
                                             VerticalAlignment="Center" Foreground="#10B981"/>
                    <TextBlock Text="Respaldar ahora" Margin="12,0,0,0" 
                               VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </Button>

            <!-- Perfil de Usuario -->
            <Border Margin="12" Padding="12" CornerRadius="8" Background="#14FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="32" Height="32" Fill="{StaticResource BrushAcento}"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="{Binding UsuarioActual.Nombre}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UsuarioActual.Rol}" Foreground="#8899AA" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>