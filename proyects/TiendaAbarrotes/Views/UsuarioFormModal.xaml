<Window x:Class="TiendaAbarrotes.Views.UsuarioFormModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Usuario" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <StackPanel Margin="25">
        <TextBlock x:Name="TituloLabel" Text="NUEVO USUARIO" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrushAcento}"/>
        <TextBlock x:Name="SubtituloLabel" Text="Alta de usuario" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,20"/>

        <TextBlock Text="Nombre completo *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="NombreText" Height="42" Padding="10" Margin="0,0,0,12"/>

        <TextBlock Text="Usuario *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameText" Height="42" Padding="10" Margin="0,0,0,12"/>

        <TextBlock x:Name="PasswordLabel" Text="Contraseña *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordText" Height="42" Padding="10" Margin="0,0,0,4"/>
        <TextBlock x:Name="PasswordHint" Text="Mínimo 4 caracteres"
                   Foreground="{StaticResource BrushTextoTerciario}" FontSize="11"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Rol *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <ComboBox x:Name="RolCombo" Height="42" Margin="0,0,0,12">
            <ComboBoxItem Content="Administrador" Tag="ADMIN"/>
            <ComboBoxItem Content="Cajero"        Tag="CAJERO"/>
            <ComboBoxItem Content="Almacén"       Tag="ALMACEN"/>
        </ComboBox>

        <CheckBox x:Name="ActivoCheck" Content="Usuario activo"
                  Foreground="{StaticResource BrushTextoSecundario}"
                  Margin="0,0,0,15" IsChecked="True" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="Cancelar_Click"
                    Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Guardar" Click="Guardar_Click"
                    Background="{StaticResource BrushAcento}" Foreground="White"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>