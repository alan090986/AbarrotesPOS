<Window x:Class="TiendaAbarrotes.Views.AbrirCajaModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Abrir caja" Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <StackPanel Margin="25">
        <TextBlock Text="APERTURA DE CAJA" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrushAcento}"/>
        <TextBlock Text="Iniciar turno" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextoPrincipal}"/>
        <TextBlock Text="Cuenta las denominaciones con las que abres la caja (fondo para cambio)."
                   Foreground="{StaticResource BrushTextoSecundario}" 
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <!-- Grid de denominaciones -->
        <Border Background="White" CornerRadius="12" Padding="16"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <StackPanel>
                <!-- Encabezado -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Denominación" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock Grid.Column="1" Text="Cantidad" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock Grid.Column="2" Text="Total" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoSecundario}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Separator Margin="0,0,0,6"/>

                <ItemsControl x:Name="DenominacionesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ValorTexto}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoPrincipal}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="6" TextAlignment="Center"
                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding TotalTexto}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAcento}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10"/>

                <Grid>
                    <TextBlock Text="TOTAL INICIAL" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalText" Text="$0.00" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource BrushAcento}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click"
                    Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Abrir caja" Click="Abrir_Click"
                    Background="{StaticResource BrushAcento}" Foreground="White"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>