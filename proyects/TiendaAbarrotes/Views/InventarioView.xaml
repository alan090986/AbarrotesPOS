<UserControl x:Class="TiendaAbarrotes.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TiendaAbarrotes.Controls">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="OPERACIÓN" Foreground="{StaticResource BrushAcento}"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Inventario" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextoPrincipal}"/>
                <TextBlock Text="Controla entradas, salidas y ajustes de stock."
                           Foreground="{StaticResource BrushTextoSecundario}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Entrada" Command="{Binding NuevaEntradaCommand}"
                        Background="{StaticResource BrushExito}" Foreground="White"
                        Height="42" Padding="18,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="− Salida" Command="{Binding NuevaSalidaCommand}"
                        Background="{StaticResource BrushPeligro}" Foreground="White"
                        Height="42" Padding="18,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Botón de actualizar -->
                <Button Command="{Binding RecargarCommand}"
                        Background="White" BorderThickness="1" BorderBrush="{StaticResource BrushBorde}"
                        Height="42" Padding="15,0" Cursor="Hand" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                 Foreground="{StaticResource BrushTextoSecundario}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Actualizar" Margin="8,0,0,0"
                                   Foreground="{StaticResource BrushTextoSecundario}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Content="+ Entrada" Command="{Binding NuevaEntradaCommand}"
                        Background="{StaticResource BrushExito}" Foreground="White"
                        Height="42" Padding="18,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="− Salida" Command="{Binding NuevaSalidaCommand}"
                        Background="{StaticResource BrushPeligro}" Foreground="White"
                        Height="42" Padding="18,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- KPIs -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <controls:KpiCard Titulo="SKUs Activos"
                              Valor="{Binding KpiSKUs}"
                              Subtitulo="Productos en catálogo"
                              Icon="PackageVariantClosed"
                              IconBackground="#EEF2FF" IconForeground="#5E5CE6"
                              Margin="5"/>
            <controls:KpiCard Titulo="Valor Inventario"
                              Valor="{Binding KpiValorInventario}"
                              Subtitulo="A precio de compra"
                              Icon="CashMultiple"
                              IconBackground="#ECFDF5" IconForeground="#10B981"
                              Margin="5"/>
            <controls:KpiCard Titulo="Stock Bajo"
                              Valor="{Binding KpiStockBajo}"
                              Subtitulo="Requieren reposición"
                              Icon="AlertOutline"
                              IconBackground="#FEF2F2" IconForeground="#EF4444"
                              Margin="5"/>
            <controls:KpiCard Titulo="Movs. Hoy"
                              Valor="{Binding KpiMovsHoy}"
                              Subtitulo="Entradas y salidas"
                              Icon="SwapVertical"
                              IconBackground="#FFFBEB" IconForeground="#F59E0B"
                              Margin="5"/>
        </UniformGrid>

        <!-- Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <RadioButton Content="Stock actual" GroupName="Tab"
                         IsChecked="True" Checked="Tab_Checked" Tag="0"
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         Margin="0,0,15,0"/>
            <RadioButton Content="Historial de movimientos" GroupName="Tab"
                         Checked="Tab_Checked" Tag="1"
                         Style="{StaticResource MaterialDesignTabRadioButton}"/>
        </StackPanel>

        <!-- Filtros de stock -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,15"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <Grid>
                <TextBox Text="{Binding FiltroStock, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Padding="10"
                         materialDesign:HintAssist.Hint="Buscar por nombre o código de barras"/>
            </Grid>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabSeleccionado}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Contenido: Stock o Historial -->
        <Grid Grid.Row="4">

            <!-- STOCK -->
            <Border Background="White" CornerRadius="12" Padding="10"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabSeleccionado}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DataGrid ItemsSource="{Binding StockItems}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="#FAFBFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"    Binding="{Binding CodigoBarras}"          Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Producto"  Binding="{Binding Nombre}"                Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}"             Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="P. Compra" Binding="{Binding ValorInventarioTexto}"  Width="110" IsReadOnly="True"/>

                        <!-- Stock con indicador bajo -->
                        <DataGridTemplateColumn Header="Stock" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StockTexto}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                        <materialDesign:PackIcon Kind="AlertCircle"
                                                                 Width="16" Height="16"
                                                                 Foreground="{StaticResource BrushPeligro}"
                                                                 Margin="6,0,0,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimoTexto}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Valor"  Binding="{Binding ValorInventarioTexto}" Width="110" IsReadOnly="True"/>

                        <!-- Botón agregar rápido -->
                        <DataGridTemplateColumn Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AgregarStockCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Padding="0"
                                            ToolTip="Agregar stock (entrada rápida)">
                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                                 Foreground="{StaticResource BrushExito}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- HISTORIAL -->
            <Border Background="White" CornerRadius="12" Padding="10"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabSeleccionado}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0"
                                 Text="{Binding FiltroHistorial, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Padding="10"
                                 materialDesign:HintAssist.Hint="Buscar por producto"/>
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding TipoSeleccionado}"
                                  SelectedValuePath="Tag"
                                  Height="40">
                            <ComboBoxItem Content="Todos los tipos" Tag="TODOS"/>
                            <ComboBoxItem Content="Solo entradas"   Tag="ENTRADA"/>
                            <ComboBoxItem Content="Solo salidas"    Tag="SALIDA"/>
                            <ComboBoxItem Content="Solo ajustes"    Tag="AJUSTE"/>
                        </ComboBox>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Movimientos}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"     Binding="{Binding FechaTexto}"     Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Producto"  Binding="{Binding NombreProducto}" Width="*"   IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo"      Binding="{Binding TipoTexto}"      Width="90"  IsReadOnly="True"/>

                            <!-- Cantidad con color según signo -->
                            <DataGridTemplateColumn Header="Cantidad" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CantidadTexto}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushPeligro}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TipoMovimiento}" Value="ENTRADA">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushExito}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Motivo"    Binding="{Binding Motivo}"     Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Usuario"   Binding="{Binding Usuario}"    Width="140" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>