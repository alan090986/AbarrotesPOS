<Window x:Class="TiendaAbarrotes.Views.MovimientoStockModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movimiento de stock" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <StackPanel Margin="25">
        <TextBlock x:Name="TituloLabel" Text="ENTRADA DE STOCK" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrushAcento}"/>
        <TextBlock x:Name="SubtituloLabel" Text="Registrar entrada" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,20"/>

        <!-- Código de barras (opcional, para buscar rápido) -->
        <TextBlock Text="Buscar por código de barras" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="CodigoText" Height="42" Padding="10" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Escanea o escribe y presiona Enter"
                 KeyDown="CodigoText_KeyDown"/>

        <!-- Producto -->
        <TextBlock Text="Producto *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <ComboBox x:Name="ProductoCombo" Height="42" Margin="0,0,0,4"
                  DisplayMemberPath="Display"
                  SelectionChanged="ProductoCombo_SelectionChanged"/>
        <TextBlock x:Name="StockActualLabel" Text="" FontSize="11"
                   Foreground="{StaticResource BrushTextoTerciario}" Margin="0,0,0,12"/>

        <!-- Cantidad -->
        <TextBlock x:Name="CantidadLabel" Text="Cantidad *" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="CantidadText" Height="48" FontSize="18" Padding="10"
                 materialDesign:HintAssist.Hint="0" Margin="0,0,0,12"/>

        <!-- Motivo -->
        <TextBlock Text="Motivo" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="MotivoText" Height="42" Padding="10" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Ej. Compra a proveedor, merma, conteo físico"/>

        <!-- Referencia -->
        <TextBlock Text="Referencia (opcional)" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
        <TextBox x:Name="ReferenciaText" Height="42" Padding="10" Margin="0,0,0,15"
                 materialDesign:HintAssist.Hint="Ej. Factura A-1234, folio"/>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="Cancelar_Click"
                    Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Guardar" Click="Guardar_Click"
                    Background="{StaticResource BrushAcento}" Foreground="White"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>