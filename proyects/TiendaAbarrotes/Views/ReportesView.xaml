<UserControl x:Class="TiendaAbarrotes.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:TiendaAbarrotes.Controls">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="ANÁLISIS" Foreground="{StaticResource BrushAcento}"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Reportes de Ventas" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextoPrincipal}"/>
                <TextBlock Text="Consulta el historial de ventas por rango de fechas."
                           Foreground="{StaticResource BrushTextoSecundario}"/>
            </StackPanel>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,15"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Desde" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FechaInicio}" Height="40" Width="140"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Hasta" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FechaFin}" Height="40" Width="140"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}"
                        Background="{StaticResource BrushAcento}" Foreground="White"
                        Height="40" Padding="20,0" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- KPIs -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
            <controls:KpiCard Titulo="Ingresos del Periodo"
                              Valor="{Binding TotalVentasTexto}"
                              Subtitulo="{Binding NumeroVentasTexto}"
                              Icon="CashMultiple"
                              IconBackground="#ECFDF5" IconForeground="#10B981"
                              Margin="5"/>
            <Border Background="White" CornerRadius="12" Padding="20" Margin="5"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DETALLE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushAcento}" Margin="0,0,0,5"/>
                    <TextBlock Text="El historial muestra las ventas completadas. Las ventas canceladas no se incluyen en el cálculo."
                               Foreground="{StaticResource BrushTextoSecundario}" FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tabla -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="10"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <DataGrid ItemsSource="{Binding Ventas}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent"
                      RowBackground="Transparent" AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio"        Binding="{Binding IdVenta}"     Width="80"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Fecha"        Binding="{Binding FechaTexto}"  Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cajero"       Binding="{Binding Usuario}"     Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Pago"         Binding="{Binding MetodoPago}"  Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Total"        Binding="{Binding TotalTexto}"  Width="120" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>