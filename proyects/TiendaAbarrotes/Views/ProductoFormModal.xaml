<Window x:Class="TiendaAbarrotes.Views.ProductoFormModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Producto" Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="750">
        <StackPanel Margin="25">
            <TextBlock x:Name="TituloLabel" Text="NUEVO PRODUCTO" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource BrushAcento}"/>
            <TextBlock x:Name="SubtituloLabel" Text="Alta de producto" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,20"/>

            <!-- Código de barras -->
            <TextBlock Text="Código de barras (opcional)" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CodigoText" Grid.Column="0" Height="42" Padding="10"
                         materialDesign:HintAssist.Hint="Escanea o escribe el código"
                         KeyDown="CodigoText_KeyDown"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextoTerciario}" FontSize="11"
                           Text="Presiona Enter para validar"/>
            </Grid>

            <!-- Nombre -->
            <TextBlock Text="Nombre *" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <TextBox x:Name="NombreText" Height="42" Padding="10" Margin="0,0,0,12"/>

            <!-- Descripción -->
            <TextBlock Text="Descripción (opcional)" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <TextBox x:Name="DescripcionText" Height="50" Padding="10" TextWrapping="Wrap"
                     AcceptsReturn="True" Margin="0,0,0,12"/>

            <!-- Categoría + botón nueva -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Categoría *" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoriaCombo" Height="42"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Nueva"
                        Click="NuevaCategoria_Click"
                        Background="White" Foreground="{StaticResource BrushAcento}"
                        Height="42" Padding="14,0" BorderThickness="1"
                        BorderBrush="{StaticResource BrushBorde}"
                        VerticalAlignment="Bottom" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </Grid>

            <!-- Unidad de medida -->
            <TextBlock Text="Unidad de medida" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <ComboBox x:Name="UnidadCombo" Height="42" Margin="0,0,0,12">
                <ComboBoxItem Content="Pieza"  Tag="PZA"/>
                <ComboBoxItem Content="Kilo"   Tag="KG"/>
                <ComboBoxItem Content="Litro"  Tag="LT"/>
                <ComboBoxItem Content="Caja"   Tag="CAJA"/>
                <ComboBoxItem Content="Paquete" Tag="PAQ"/>
            </ComboBox>

            <!-- Precios -->
            <UniformGrid Rows="1" Columns="2" Margin="0,0,0,12">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Precio compra *" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PrecioCompraText" Height="42" Padding="10"
                             materialDesign:HintAssist.Hint="0.00"
                             TextChanged="PrecioText_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Precio venta *" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PrecioVentaText" Height="42" Padding="10"
                             materialDesign:HintAssist.Hint="0.00"
                             TextChanged="PrecioText_TextChanged"/>
                </StackPanel>
            </UniformGrid>

            <!-- Margen -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Margen de ganancia:" Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock x:Name="MargenText" Text="0%" 
                               HorizontalAlignment="Right" FontWeight="Bold"
                               Foreground="{StaticResource BrushExito}"/>
                </Grid>
            </Border>

            <!-- Stock mínimo -->
            <TextBlock Text="Stock mínimo (alerta de reposición)" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <TextBox x:Name="StockMinimoText" Height="42" Padding="10" Text="0"
                     Margin="0,0,0,15"/>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click"
                        Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                        Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"/>
                <Button Content="Guardar" Click="Guardar_Click"
                        Background="{StaticResource BrushAcento}" Foreground="White"
                        Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                        FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>