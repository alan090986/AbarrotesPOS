<UserControl x:Class="TiendaAbarrotes.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="CATÁLOGO" Foreground="{StaticResource BrushAcento}"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Productos" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextoPrincipal}"/>
                <TextBlock Text="Administra el catálogo de productos de tu tienda."
                           Foreground="{StaticResource BrushTextoSecundario}"/>
            </StackPanel>
            <Button Content="+ Nuevo producto"
                    Command="{Binding NuevoProductoCommand}"
                    Background="{StaticResource BrushAcento}" Foreground="White"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="42" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,15"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="10"
                             materialDesign:HintAssist.Hint="Buscar por nombre o código de barras"/>
                </StackPanel>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding CategoriaSeleccionada}"
                          DisplayMemberPath="Nombre"
                          Height="42"/>
            </Grid>
        </Border>

        <!-- Mensaje -->
        <TextBlock Grid.Row="2" Text="{Binding Mensaje}" Margin="0,0,0,10" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushExito}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushPeligro}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Tabla -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="10"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <DataGrid ItemsSource="{Binding Productos}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent"
                      RowBackground="Transparent" AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código"    Binding="{Binding CodigoBarras}"     Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Producto"  Binding="{Binding Nombre}"           Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}"        Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="P. Compra" Binding="{Binding PrecioCompraTexto}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="P. Venta"  Binding="{Binding PrecioVentaTexto}"  Width="100" IsReadOnly="True"/>

                    <!-- Stock con indicador -->
                    <DataGridTemplateColumn Header="Stock" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StockTexto}" 
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextoPrincipal}"/>
                                    <materialDesign:PackIcon Kind="AlertCircle" 
                                                             Width="16" Height="16"
                                                             Foreground="{StaticResource BrushPeligro}"
                                                             Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             ToolTip="Stock bajo">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones -->
                    <DataGridTemplateColumn Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.EditarProductoCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Padding="0" ToolTip="Editar">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"
                                                                 Foreground="{StaticResource BrushAcento}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.EliminarProductoCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Padding="0" ToolTip="Desactivar">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"
                                                                 Foreground="{StaticResource BrushPeligro}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>