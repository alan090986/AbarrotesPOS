<UserControl x:Class="TiendaAbarrotes.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:TiendaAbarrotes.ViewModels.Modules">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado de página -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
    <TextBlock Text="OPERACIÓN" Foreground="{StaticResource BrushAcento}"
               FontSize="11" FontWeight="Bold"/>
    <Grid>
        <StackPanel>
            <TextBlock Text="Punto de Venta" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextoPrincipal}"/>
            <TextBlock Text="Escanea el código de barras o ingrésalo manualmente."
                       Foreground="{StaticResource BrushTextoSecundario}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding CajaEstado}" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,15,0"/>
            <Button Content="Abrir caja" Command="{Binding AbrirCajaCommand}"
                    Background="{StaticResource BrushExito}" Foreground="White"
                    Height="38" Padding="16,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cerrar caja" Command="{Binding CerrarCajaCommand}"
                    Background="{StaticResource BrushPeligro}" Foreground="White"
                    Height="38" Padding="16,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ====== COLUMNA IZQUIERDA: CARRITO ====== -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                    Effect="{StaticResource MaterialDesignShadowDepth1}" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Input de código de barras -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Código de barras" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,6"/>
                        <TextBox x:Name="BarcodeInput"
                                 Text="{Binding CodigoActual, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Padding="12" Height="48"
                                 materialDesign:HintAssist.Hint="Escanea o escribe el código y presiona Enter"
                                 KeyDown="BarcodeInput_KeyDown"/>
                    </StackPanel>

                    <!-- Mensaje de feedback -->
                    <TextBlock Grid.Row="1" Text="{Binding Mensaje}" Margin="0,0,0,10" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushExito}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPeligro}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Lista del carrito -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Carrito}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="P. Unit" Binding="{Binding PrecioUnitarioFormateado}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="70"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalFormateado}" Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.QuitarItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="30" Height="30" Padding="0">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                                     Foreground="{StaticResource BrushPeligro}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ====== COLUMNA DERECHA: RESUMEN Y COBRO ====== -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Resumen" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1">
                        <!-- Artículos -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Artículos" Foreground="{StaticResource BrushTextoSecundario}"/>
                            <TextBlock Text="{Binding TotalArticulos}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Separator Margin="0,0,0,15"/>

                        <!-- Método de pago -->
                        

                        <!-- Gran total -->
                        <Border Background="#F4F7FC" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="TOTAL" Foreground="{StaticResource BrushTextoSecundario}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalFormateado}" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextoPrincipal}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botones -->
                    <StackPanel Grid.Row="2">
                        <Button Command="{Binding CobrarCommand}"
                                Background="{StaticResource BrushAcento}" Foreground="White"
                                Height="52" FontSize="16" FontWeight="Bold" BorderThickness="0"
                                Margin="0,10,0,10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cobrar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LimpiarCarritoCommand}"
                                Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                                Height="40" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="Cancelar venta" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>