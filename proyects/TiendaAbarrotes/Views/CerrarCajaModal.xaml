<Window x:Class="TiendaAbarrotes.Views.CerrarCajaModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cerrar caja" Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== COLUMNA IZQUIERDA: Resumen ======== -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="CIERRE DE CAJA" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource BrushAcento}"/>
            <TextBlock Text="Cerrar turno" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

            <Border Background="White" CornerRadius="12" Padding="16"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Monto inicial" Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock x:Name="MontoInicialText" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Ventas en efectivo" Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock x:Name="VentasEfectivoText" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Ventas con tarjeta" Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock x:Name="VentasTarjetaText" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Ventas por transferencia" Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock x:Name="VentasTransfText" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Separator Margin="0,8"/>
                    <Grid>
                        <TextBlock Text="EFECTIVO ESPERADO" FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBlock x:Name="MontoEsperadoText" Text="$0.00" HorizontalAlignment="Right" 
                                   FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource BrushAcento}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Diferencia -->
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,15,0,0"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <StackPanel>
                    <TextBlock Text="DIFERENCIA" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextoSecundario}"/>
                    <TextBlock x:Name="DiferenciaText" Text="$0.00" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBlock x:Name="DiferenciaLabel" Text="" FontSize="12"
                               Foreground="{StaticResource BrushTextoSecundario}"/>
                </StackPanel>
            </Border>

            <!-- Desglose de Apertura -->
            <TextBlock Text="Desglose con el que abrió caja:" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,15,0,4"/>
            <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <TextBlock x:Name="DesgloseAperturaText" Text="Sin desglose registrado" 
                           Foreground="{StaticResource BrushTextoPrincipal}" 
                           TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <!-- Observaciones -->
            <TextBlock Text="Observaciones (opcional)" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,6"/>
            <TextBox x:Name="ObservacionesText" Height="60" Padding="10"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- ======== COLUMNA DERECHA: Conteo físico ======== -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="CONTEO FÍSICO" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource BrushAcento}"/>
            <TextBlock Text="Cuenta el efectivo" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextoPrincipal}" Margin="0,0,0,15"/>

            <Border Background="White" CornerRadius="12" Padding="16"
                    Effect="{StaticResource MaterialDesignShadowDepth1}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Denominación" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock Grid.Column="1" Text="Cantidad" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextoSecundario}"/>
                        <TextBlock Grid.Column="2" Text="Total" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextoSecundario}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Separator Margin="0,0,0,6"/>

                    <ItemsControl x:Name="DenominacionesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ValorTexto}"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextoPrincipal}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" Padding="6" TextAlignment="Center"
                                             Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalTexto}"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAcento}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,10"/>

                    <Grid>
                        <TextBlock Text="TOTAL CONTADO" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextoPrincipal}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalContadoText" Text="$0.00" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAcento}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ======== BOTONES ======== -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click"
                    Background="Transparent" Foreground="{StaticResource BrushPeligro}"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Confirmar cierre" Click="Cerrar_Click"
                    Background="{StaticResource BrushAcento}" Foreground="White"
                    Height="44" Padding="20,0" BorderThickness="0" Cursor="Hand"
                    FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>