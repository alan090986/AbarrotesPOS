<Window x:Class="TiendaAbarrotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TiendaAbarrotes.Controls"
        Title="AbarrotesPOS" Height="800" Width="1400" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFondo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar reutilizable -->
        <controls:SidebarControl Grid.Column="0" DataContext="{Binding}"/>

        <!-- Área de contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header reutilizable -->
            <controls:HeaderControl Grid.Row="0" DataContext="{Binding}"/>

            <!-- Aquí se inyectan las vistas de cada módulo -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
